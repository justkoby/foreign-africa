# SERVER ONLY. Configure these in Vercel project settings; never use VITE_ for secrets.
GEMINI_API_KEY=
# Set a currently available Gemini generateContent model supporting JSON structured output.
GEMINI_MODEL=
# LOCAL DEVELOPMENT ONLY: password for the Vite dev server's file editor. The Express server ignores it;
# /editor now redirects into the Studio and uses Studio accounts. Never set this on Hostinger.
CMS_PASSWORD=
# 1 lets the Studio write the file collections (events, people, engage, forms). Default: on in development,
# off in staging and production. Leave unset on Hostinger.
LEGACY_FILE_EDITING=

# MySQL for the staff studio. Server only. Never prefix with VITE_.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
SESSION_SECRET=
APP_ENV=development
PUBLIC_SITE_URL=http://localhost:5173
MEDIA_ROOT=
# Staging only. Required before preview.foreignafrica.org is reachable.
STAGING_USER=
STAGING_PASSWORD=
# Set to 1 on Hostinger staging so startup runs migrate, the first administrator, and the idempotent seed.
# Business hosting cannot run these npm scripts over SSH. Remove BOOTSTRAP_ADMIN_PASSWORD from the panel after the first successful start.
PREPARE_DATABASE=
# Used once by npm run bootstrap-admin. Do not commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
