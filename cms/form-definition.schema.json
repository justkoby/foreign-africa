{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreignafrica.org/schemas/form-definition-v1.json",
  "title": "Foreign Africa versioned form definition \u2014 future CMS contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "purpose",
    "ownerType",
    "ownerId",
    "status",
    "fields",
    "privacyNotice",
    "consentLabel",
    "successMessage"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "purpose": {
      "enum": [
        "fellowship_application",
        "internship_application",
        "paper_submission",
        "volunteer_interest",
        "event_registration",
        "partnership_enquiry",
        "sponsorship_enquiry",
        "speaker_request",
        "general_enquiry",
        "job_application"
      ]
    },
    "ownerType": {
      "enum": [
        "opportunity",
        "event",
        "engagement",
        "vacancy"
      ]
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "enum": [
        "draft",
        "open",
        "closed",
        "archived"
      ]
    },
    "opensAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "closesAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "label",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "type": {
            "enum": [
              "text",
              "email",
              "tel",
              "url",
              "number",
              "textarea",
              "select",
              "multiselect",
              "checkbox",
              "date",
              "file"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "required": {
            "type": "boolean"
          },
          "help": {
            "type": "string",
            "maxLength": 1000
          },
          "options": {
            "type": "array",
            "maxItems": 60,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760
          },
          "accept": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "application/pdf",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                "image/jpeg",
                "image/png"
              ]
            }
          }
        }
      }
    },
    "privacyNotice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "consentLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "successMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    }
  }
}
