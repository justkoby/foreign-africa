+    themes:[{title:'Foreign policy & governance',text:'Analysis of institutions, international affairs and public decision-making.',icon:'dialogue'},{title:'Enterprise & development',text:'Evidence on entrepreneurship and economic development.',icon:'enterprise'},{title:'Regional integration',text:'Perspectives on cooperation, connection and Africa’s shared priorities.',icon:'network'}],
