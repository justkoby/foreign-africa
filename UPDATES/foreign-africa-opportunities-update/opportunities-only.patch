+/* Opportunity overviews deliberately contain no application or registration state. */
+.opportunities-page{--op-muted:#566872;--op-green:#e8ede7}
+.opportunity-hub-hero,.opportunity-detail-hero{background:var(--navy);color:white;padding:140px 0 65px}
+.opportunity-breadcrumb{display:flex;align-items:center;flex-wrap:wrap;gap:8px 12px;font-size:11px;color:#b5c8d1;line-height:1.6}
+.opportunity-breadcrumb a:hover{text-decoration:underline}.opportunity-breadcrumb>span[aria-hidden]{opacity:.5}
+.opportunity-hub-heading{display:grid;grid-template-columns:1.25fr 1fr;align-items:center;gap:50px;margin-top:48px}
+.opportunity-hub-heading .eyebrow,.opportunity-detail-heading>div>.eyebrow{color:var(--gold);font-size:10px;margin-bottom:22px}
+.opportunity-hub-heading h1{font-size:clamp(43px,4.8vw,69px);line-height:1.1;letter-spacing:-2.5px;font-weight:500}
+.opportunity-hub-heading h1 em{font:inherit;color:var(--gold)}
+.opportunity-hub-heading>div>p:not(.eyebrow){font-size:15px;color:#bfced7;max-width:440px;margin-top:25px}
+.opportunity-hub-heading .text-link,.opportunity-detail-heading>div>.text-link{color:var(--gold);margin-top:28px;font-size:12px;gap:22px}
+.opportunity-visual{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:25px 0;overflow:hidden;min-width:0}
+.opportunity-visual-label,.opportunity-visual-note{font-size:8px;letter-spacing:2px;color:#b5c8d1;text-align:center}
+.opportunity-orbit{position:relative;width:280px;height:280px;border:1px solid #d8bb7555;border-radius:50%;margin-block:25px}
+.opportunity-orbit:before{content:'';position:absolute;inset:30px;border:1px solid #d8bb7525;border-radius:50%}
+.opportunity-orbit>span{position:absolute;background:#17384d;border:1px solid #d8bb7540;padding:9px 15px;font-size:11px;border-radius:2px;z-index:1}
+.opportunity-orbit>span:nth-child(1){top:12px;left:5px}.opportunity-orbit>span:nth-child(2){right:-10px;top:100px}.opportunity-orbit>span:nth-child(3){bottom:-8px;left:28px}
+.opportunity-orbit-core{position:absolute;inset:65px;display:flex;align-items:center;justify-content:center;gap:12px;background:#143347;border-radius:50%}
+.opportunity-orbit-core img{width:50px;height:55px;object-fit:contain}.opportunity-orbit-core strong{font-size:16px;line-height:1.1;font-weight:700;letter-spacing:-.3px}
+.opportunity-pathways{padding-block:80px}
+.opportunity-pathways .section-heading>p{font-size:14px;line-height:1.8}
+.pathway-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
+.pathway-card{background:white;border:1px solid #d7ded7;min-width:0}
+.pathway-card>a{display:flex;flex-direction:column;min-height:100%;padding:34px;transition:background .25s}
+.pathway-card>a:hover{background:#f0f2ec}.pathway-card>a:hover .pathway-card-link svg{transform:translate(3px,-3px)}
+.pathway-card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:34px;color:#6a7b7d}
+.pathway-card-top>svg{color:#1b465a}.pathway-card-top>span{font-size:10px;letter-spacing:2px}
+.pathway-card .eyebrow{font-size:9px;letter-spacing:1.3px;color:#806326;margin-bottom:14px}
+.pathway-card h3{font-size:30px;line-height:1.15;letter-spacing:-.9px;font-weight:700;max-width:440px}
+.pathway-summary{font-size:14px;line-height:1.8;color:#566872;margin-top:18px;max-width:470px}
+.pathway-card-link{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-top:auto;padding-top:28px;font-size:12px;font-weight:500}
+.pathway-card-link svg{transition:transform .25s}
