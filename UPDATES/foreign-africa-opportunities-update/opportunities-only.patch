+
+function Questions(){return <section className="container opportunity-questions" id="questions"><div><p className="eyebrow">A LITTLE MORE CLARITY</p><h2>Before your<br/>next step.</h2><p>Practical answers to help<br/>you find your way.</p></div><div className="opportunity-faq-list">{opportunityFaqs.map(item=><details key={item.question}><summary>{item.question}<Plus size={19} aria-hidden="true"/></summary><div><p>{item.answer}</p>{item.href&&<a className="text-link" href={item.href}>{item.linkLabel}<ArrowUpRight size={16} aria-hidden="true"/></a>}</div></details>)}</div></section>}
+
+export function OpportunitiesPage(){return <div className="fa-inner-page opportunities-page"><section className="opportunity-hub-hero"><div className="container"><OpportunityCrumb/><div className="opportunity-hub-heading"><div><p className="eyebrow">LEARN. CONTRIBUTE. CONNECT.</p><h1>Bring your perspective.<br/><em>Find your place.</em></h1><p>Explore ways to connect with Foreign Africa through research, volunteering and enterprise.</p><a className="text-link" href="#pathways">Explore the pathways <ArrowDown size={17} aria-hidden="true"/></a></div><div className="opportunity-visual" aria-hidden="true"><span className="opportunity-visual-label">MANY WAYS TO CONTRIBUTE</span><div className="opportunity-orbit"><span>Ideas</span><span>Skills</span><span>Connections</span><div className="opportunity-orbit-core"><img src="/images/logo-mark.svg" alt=""/><strong>Foreign<br/>Africa</strong></div></div><span className="opportunity-visual-note">ONE CONNECTED PURPOSE</span></div></div></div></section><section className="container opportunity-pathways" id="pathways"><div className="section-heading"><div><p className="eyebrow">CHOOSE YOUR PATHWAY</p><h2>Different strengths.<br/>A shared ambition.</h2></div><p>Start with what interests you.<br/>Explore what each pathway involves.</p></div><div className="pathway-grid">{opportunityPathways.map((item,index)=><PathwayCard key={item.id} item={item} index={index}/>)}</div><div className="opportunity-current-note"><span className="opportunity-status-label"><span/>PROGRAMME INFORMATION</span><div><h3>Exploring now. Planning your next step.</h3><p>These pages introduce the pathways. Specific calls, volunteer roles and Enterprise Week edition details are not listed here yet. You can email the team to ask about participation.</p></div><a className="text-link" href="mailto:info@foreignafrica.org?subject=Opportunities%20enquiry">Ask the team <ArrowUpRight size={17} aria-hidden="true"/></a></div></section><Questions/><section className="opportunity-explore"><div className="container"><div><p className="eyebrow">GET TO KNOW OUR WORK</p><h2>Start with<br/>the conversation.</h2></div><div><a href="/blog/"><span>Read our commentaries</span><ArrowUpRight size={21} aria-hidden="true"/></a><a href="/policy-briefs/"><span>Explore policy briefs</span><ArrowUpRight size={21} aria-hidden="true"/></a><a href="/our-people/"><span>Meet our people</span><ArrowUpRight size={21} aria-hidden="true"/></a></div></div></section></div>}
+
+export function OpportunityDetailPage({id}){
+ const item=getOpportunityPathway(id);
+ if(!item)return <OpportunitiesPage/>;
+ return <div className="fa-inner-page opportunities-page"><section className={`opportunity-detail-hero opportunity-detail-hero--${item.icon}`}><div className="container"><OpportunityCrumb title={item.shortTitle??item.title}/><div className="opportunity-detail-heading"><div><p className="eyebrow">{item.label}</p><h1>{item.titleLines.map(line=><span key={line}>{line}</span>)}</h1><p>{item.summary}</p><a className="text-link" href="#opportunity-overview">Discover the pathway <ArrowDown size={17} aria-hidden="true"/></a></div><aside className="opportunity-status-card" aria-label="Current information"><div className="opportunity-status-card-top"><PathwayIcon name={item.icon} size={33}/><span className="eyebrow">CURRENT INFORMATION</span></div><h2>{item.status}</h2><p>{item.statusDetail}</p><a className="button gold" href={enquiryHref(item)}>{item.enquiryLabel}<Mail size={18} aria-hidden="true"/></a><p className="opportunity-email-note">Opens your email app.</p></aside></div></div></section><nav className="fa-section-nav opportunity-section-nav" aria-label="On this page"><div className="container"><a href="#opportunity-overview">Overview</a><a href="#pathway-focus">Focus areas</a><a href="#next-step">Your next step</a><a href="#other-pathways">Other pathways</a></div></nav><section className="container opportunity-overview" id="opportunity-overview"><div><p className="eyebrow">THE PATHWAY</p><h2>{item.tagline[0]}<br/>{item.tagline[1]}</h2></div><div><p className="opportunity-overview-lead">{item.overview}</p><div className="opportunity-audience"><span className="eyebrow">WHO IT BRINGS TOGETHER</span><p>{item.audience}</p></div><a className="text-link" href={item.related.href}>{item.related.label}<ArrowUpRight size={17} aria-hidden="true"/></a></div></section><section className="opportunity-focus" id="pathway-focus"><div className="container"><div className="section-heading"><div><p className="eyebrow">EXPLORE THE FOCUS</p><h2>Where ideas<br/>and people connect.</h2></div><p>Explore the programme’s areas of focus.</p></div><div className="opportunity-theme-grid">{item.themes.map((theme,index)=><article key={theme.title}><div><PathwayIcon name={theme.icon} size={27}/><span>0{index+1}</span></div><h3>{theme.title}</h3><p>{theme.text}</p></article>)}</div></div></section><section className="container opportunity-next-step" id="next-step"><div><p className="eyebrow">YOUR NEXT STEP</p><h2>A question is<br/>a good start.</h2><p>Contact the team about {item.shortTitle?.toLowerCase()??item.title.toLowerCase()} and ask for current participation information.</p><a className="button gold" href={enquiryHref(item)}>{item.enquiryLabel}<ArrowUpRight size={18} aria-hidden="true"/></a><p className="opportunity-email-address">info@foreignafrica.org</p></div><aside className="opportunity-checklist"><h3>{item.futureHeading}</h3><p>Look for the following details in the official announcement:</p><ul>{item.futureDetails.map(text=><li key={text}><Check size={16} aria-hidden="true"/><span>{text}</span></li>)}</ul><p className="opportunity-checklist-note">Check the published announcement for confirmed requirements.</p></aside></section><section className="container opportunity-related" id="other-pathways"><div className="section-heading"><div><p className="eyebrow">KEEP EXPLORING</p><h2>Another way to connect.</h2></div><a className="text-link" href="/opportunities/">All opportunities<ArrowRight size={17} aria-hidden="true"/></a></div><div className="pathway-grid pathway-grid--related">{opportunityPathways.filter(other=>other.id!==id).map((other,index)=><PathwayCard key={other.id} item={other} index={index} compact/>)}</div><a className="opportunity-back" href="/opportunities/"><ArrowLeft size={15} aria-hidden="true"/>Back to opportunities</a></section></div>;
+}
