elected.feature.label}<ArrowUpRight size={17}/></span></a>}</div></div>}{menu&&<nav className="fa-mobile-navigation" id="fa-mobile-navigation" aria-label="Mobile navigation"><a className="fa-mobile-home" href="/" onClick={close}>Home <ArrowUpRight size={17}/></a>{megaGroups.map(group=><details key={group.id}><summary>{group.label}<ChevronDown size={17}/></summary><div>{group.columns.map(column=><div key={column.label}><p className="eyebrow">{column.label}</p>{column.links.map(([label,href])=><a href={href} key={label} onClick={close}>{label}<ArrowUpRight size={15}/></a>)}</div>)}</div></details>)}<a className="button gold" href="/#connect" onClick={close}>Let’s connect <ArrowUpRight size={19}/></a></nav>}</header></>
