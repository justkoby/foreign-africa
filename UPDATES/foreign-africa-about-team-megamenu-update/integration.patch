+export function ProfilePage({id}){const member=getMember(id);if(!member)return <section className="fa-profile-missing container"><p className="eyebrow">OUR PEOPLE</p><h1>Profile unavailable.</h1><a className="text-link" href="/our-people/">Meet our people <Arrow/></a></section>;const group=teamGroups.find(g=>g.id===member.group);return <div className="fa-inner-page"><section className="fa-profile-hero"><div className="container"><a className="fa-breadcrumb" href={group.path}><ArrowLeft size={15}/>{group.label}</a><div className="fa-profile-heading"><div><p className="eyebrow">{member.role}</p><h1>{member.name}</h1><p className="fa-profile-intro">{member.intro}</p><div className="fa-profile-contacts">{member.location&&<span><MapPin size={16}/>{member.location}</span>}{member.email&&<a href={`mailto:${member.email}`}><Mail size={16}/>{member.email}</a>}{member.phone&&<a href={`tel:${member.phone}`}><Phone size={16}/>{member.phone}</a>}{member.contactUrl&&<a href={member.contactUrl}>Get in touch <Arrow/></a>}{member.linkedin&&<a href={member.linkedin}><Linkedin size={16}/>Connect on LinkedIn <Arrow/></a>}</div></div><img className="fa-profile-portrait" src={member.image} alt={member.name} fetchPriority="high"/></div></div></section><section className="container fa-biography"><aside><p className="eyebrow">BACKGROUND & EXPERIENCE</p><h2>Biography</h2><a className="text-link" href={group.path}>Back to {group.label.toLowerCase()} <Arrow/></a></aside><div>{member.bio.map((p,i)=><p key={i}>{p}</p>)}</div></section><section className="container fa-profile-related"><div className="section-heading"><h2>Meet more of our people.</h2><a className="text-link" href="/our-people/">All people <Arrow/></a></div><div className="fa-team-grid">{teamMembers.filter(m=>m.id!==id).sort((a,b)=>Number(b.group===member.group)-Number(a.group===member.group)).slice(0,3).map(m=><PersonCard key={m.id} member={m}/>)}</div></section><ClosingCTA/></div>}
